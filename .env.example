# PayPal Configuration
# Use 'sb' for sandbox testing, or your live client ID for production
VITE_PAYPAL_CLIENT_ID=sb

# Production / preview build: absolute backend URL (no trailing slash)
VITE_API_BASE=https://your-project.vercel.app

# Optional: in dev, skip proxy and use VITE_API_BASE directly (e.g. localhost or public API)
VITE_DEV_API_DIRECT=false

# ─── Local dev with protected Vercel preview (do NOT use VITE_* for the bypass)
# Vite proxies /api → PREVIEW_PROXY_TARGET and adds x-vercel-protection-bypass.
# Put these in .env.local only. Remove any VITE_AUTOMATION_BYPASS_SECRET — it would leak to the client bundle.
PREVIEW_PROXY_TARGET=https://your-project-git-branch-user.vercel.app
VERCEL_AUTOMATION_BYPASS_SECRET=
